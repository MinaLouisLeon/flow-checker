{
  "name": "@flow-checker/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only capture runtime injected into the analyzed Next.js app (internal).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./edge": "./src/edge.ts",
    "./options": "./src/options.ts",
    "./redact": "./src/redact.ts",
    "./trpc": "./src/trpc.ts",
    "./next": "./src/next.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flow-checker/shared": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/query-core": "^5.105.0",
    "@trpc/server": "11.22.1",
    "trpc-server-v10": "npm:@trpc/server@10.45.4",
    "query-core-v4": "npm:@tanstack/query-core@^4.36.1"
  }
}
