{
  "name": "@integr8-media/flow-checker",
  "version": "0.1.0",
  "description": "Map a Next.js App Router project: pages, components, requests, types and flows, verified against live traffic and exported as documentation.",
  "keywords": [
    "nextjs",
    "app-router",
    "documentation",
    "api",
    "flows",
    "devtools",
    "next",
    "instrumentation",
    "api-docs",
    "type-checking"
  ],
  "license": "MIT",
  "author": "Mina Louis Leon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MinaLouisLeon/flow-checker.git",
    "directory": "packages/flow-checker"
  },
  "homepage": "https://github.com/MinaLouisLeon/flow-checker#readme",
  "bugs": {
    "url": "https://github.com/MinaLouisLeon/flow-checker/issues"
  },
  "type": "module",
  "bin": {
    "flow-checker": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./runtime/client": {
      "types": "./dist/runtime-client.d.ts",
      "default": "./dist/runtime-client.js"
    },
    "./runtime/server": {
      "types": "./dist/runtime-server.d.ts",
      "default": "./dist/runtime-server.js"
    },
    "./runtime/edge": {
      "types": "./dist/runtime-edge.d.ts",
      "default": "./dist/runtime-edge.js"
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "next": ">=13.4.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@flow-checker/dashboard": "workspace:*",
    "@flow-checker/exporter": "workspace:*",
    "@flow-checker/postman": "workspace:*",
    "@flow-checker/runtime": "workspace:*",
    "@flow-checker/scanner": "workspace:*",
    "@flow-checker/server": "workspace:*",
    "@flow-checker/shared": "workspace:*",
    "tsup": "catalog:"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "chokidar": "catalog:",
    "hono": "catalog:",
    "ts-morph": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
