# Fake values: the scan reads names only, and tests check that no value below ever leaves this file.
API_URL=http://localhost:4010
STRIPE_SECRET_KEY=fixture-value-stripe-secret
export WEBHOOK_SECRET='fixture-value-webhook-secret'
NEXT_PUBLIC_ANALYTICS_ID=fixture-value-analytics-id
NEXT_PUBLIC_SITE_NAME=fixture-value-site-name
NEXT_PUBLIC_SUPPORT_EMAIL=fixture-value-support-email
NEXT_PUBLIC_THEME=fixture-value-theme
PRIVATE_KEY="-----BEGIN FIXTURE KEY-----
NOT_A_NAME=fixture-value-inside-quotes
-----END FIXTURE KEY-----"
UNUSED_TOKEN=fixture-value-unused-token
